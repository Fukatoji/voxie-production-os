{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Lyric Alignment",
  "type": "object",
  "required": ["alignment_version", "alignment_id", "status", "audio", "sources", "lyrics", "review_gates"],
  "properties": {
    "alignment_version": {"type": "string"},
    "alignment_id": {"type": "string"},
    "status": {"enum": ["PROVISIONAL", "REVIEW_REQUIRED", "HUMAN_REVIEWED", "LOCKED"]},
    "audio": {
      "type": "object",
      "required": ["sha256", "duration_s"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "adapter", "weight"],
        "properties": {
          "source_id": {"type": "string"},
          "adapter": {"enum": ["accuratescribe", "lyric-align", "whisperx", "yass-reloaded", "human", "beatmap", "other"]},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "revision": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "lyrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line_id", "text", "vocal_start_s", "vocal_end_s", "confidence", "manual_review", "evidence"],
        "properties": {
          "line_id": {"type": "string"},
          "text": {"type": "string"},
          "vocal_start_s": {"type": "number", "minimum": 0},
          "vocal_end_s": {"type": "number", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "manual_review": {"type": "boolean"},
          "timing_spread_s": {"type": "number", "minimum": 0},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "vocal_start_s", "vocal_end_s", "confidence"],
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {"type": "object"},
    "review_gates": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
