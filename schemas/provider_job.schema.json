{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxie Provider Job",
  "type": "object",
  "required": ["schema_version", "job_id", "project_id", "provider", "operation", "status", "inputs", "asset_lineage", "approvals"],
  "properties": {
    "schema_version": {"type": "string"},
    "job_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "APPROVAL_REQUIRED", "APPROVED", "EXECUTED", "FAILED", "CANCELLED"]},
    "inputs": {"type": "object"},
    "asset_lineage": {
      "type": "object",
      "required": ["inputs", "output_asset_id", "output_asset_version"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset_id", "status", "version", "sha256"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["approved", "locked"]},
              "version": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "storage_location": {"type": "string", "minLength": 1},
              "provider_result_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "output_asset_id": {"type": ["string", "null"], "minLength": 1},
        "output_asset_version": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": true
    },
    "estimated_credits": {"type": ["number", "null"], "minimum": 0},
    "max_credits": {"type": ["number", "null"], "minimum": 0},
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approval_id", "gate", "status", "scope"],
        "properties": {
          "approval_id": {"type": "string", "minLength": 1},
          "gate": {"enum": ["CREATE_MEDIA", "CREDIT_SPEND", "ASSET_UPLOAD", "PUBLISH_CONTENT", "CANON_LOCK", "DESTRUCTIVE_ACTION"]},
          "status": {"enum": ["APPROVED", "REJECTED", "EXPIRED"]},
          "scope": {
            "type": "object",
            "required": ["provider", "operation"],
            "properties": {
              "provider": {"type": "string", "minLength": 1, "pattern": "^(?!\\*$).+"},
              "operation": {"type": "string", "minLength": 1, "pattern": "^(?!\\*$).+"},
              "max_credits": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {"properties": {"gate": {"const": "CREDIT_SPEND"}}, "required": ["gate"]},
            "then": {"properties": {"scope": {"required": ["max_credits"]}}}
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
