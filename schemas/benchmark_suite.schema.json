{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxie Model Benchmark Suite",
  "type": "object",
  "required": ["suite_version", "suite_id", "status", "promotion_policy", "scenarios", "adapters"],
  "properties": {
    "suite_version": {"type": "string"},
    "suite_id": {"type": "string"},
    "status": {"enum": ["DRAFT", "READY", "RUNNING", "COMPLETE", "SUPERSEDED"]},
    "promotion_policy": {
      "type": "object",
      "required": ["min_acceptance_rate", "max_identity_drift", "max_composition_drift", "max_keyframe_error_frames", "max_wing_count_error_rate"],
      "additionalProperties": true
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "motion_mode", "duration_s", "fps", "seed", "approval_gate", "required_metrics"],
        "properties": {
          "scenario_id": {"type": "string"},
          "motion_mode": {"enum": ["hold", "first_last", "arbitrary_frame_guides", "masked_repair", "motion_transfer", "audio_to_video"]},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "seed": {"type": "integer", "minimum": 0},
          "approval_gate": {"enum": ["NONE", "PAID_GENERATION", "LICENSE_REVIEW", "PRODUCTION_PROMOTION"]},
          "required_metrics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "identity_drift",
                "composition_drift",
                "keyframe_error_frames",
                "wing_count_error",
                "face_error",
                "runtime_s",
                "peak_memory_gb"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["adapter_id", "execution", "status"],
        "properties": {
          "adapter_id": {"type": "string"},
          "execution": {"enum": ["local", "runpod", "cloud_api", "desktop"]},
          "status": {"enum": ["READY", "BLOCKED_HARDWARE", "BLOCKED_CREDENTIALS", "BLOCKED_APPROVAL", "WATCH"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
