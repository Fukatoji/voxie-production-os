{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxie Release Readiness",
  "type": "object",
  "required": [
    "report_version",
    "report_id",
    "record_type",
    "project_id",
    "project_title",
    "status",
    "master",
    "release_gate",
    "platforms",
    "findings",
    "next_action"
  ],
  "properties": {
    "report_version": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "record_type": {
      "const": "release_readiness"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "READY_FOR_RELEASE",
        "RELEASED",
        "BLOCKED"
      ]
    },
    "master": {
      "type": "object",
      "required": [
        "manifest",
        "status",
        "controlled_filename",
        "sha256",
        "duration_seconds",
        "resolution",
        "fps",
        "video_codec",
        "audio_codec",
        "source_audio_preserved"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "pattern": "^manifests/[^\\s]+$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "controlled_filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "resolution": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "video_codec": {
          "type": "string",
          "minLength": 1
        },
        "audio_codec": {
          "type": "string",
          "minLength": 1
        },
        "source_audio_preserved": {
          "type": "boolean"
        },
        "final_review_record": {
          "type": "string",
          "pattern": "^manifests/[^\\s]+$"
        }
      },
      "additionalProperties": true
    },
    "release_gate": {
      "type": "object",
      "required": [
        "execution_authority",
        "publication_authorized",
        "scheduling_authorized",
        "account_write_authorized",
        "required_approvals",
        "blockers"
      ],
      "properties": {
        "execution_authority": {
          "enum": ["BLOCKED", "AUTHORIZED"]
        },
        "publication_authorized": {
          "type": "boolean"
        },
        "scheduling_authorized": {
          "type": "boolean"
        },
        "account_write_authorized": {
          "type": "boolean"
        },
        "required_approvals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "format",
          "package_status",
          "upload_authorized",
          "publish_authorized"
        ],
        "properties": {
          "platform": {
            "enum": ["youtube", "tiktok", "instagram"]
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "package_status": {
            "type": "string",
            "minLength": 1
          },
          "upload_authorized": {
            "type": "boolean"
          },
          "publish_authorized": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "rule_id", "message"],
        "properties": {
          "severity": {
            "enum": ["info", "warning", "error"]
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "shot_id": {
            "type": ["string", "null"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
