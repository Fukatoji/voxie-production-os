{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxie Canonical Authority Index",
  "type": "object",
  "required": [
    "index_version",
    "index_id",
    "record_type",
    "status",
    "recorded_date",
    "repository",
    "default_branch",
    "policy",
    "entries"
  ],
  "properties": {
    "index_version": {
      "type": "string",
      "minLength": 1
    },
    "index_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "record_type": {
      "const": "authority_index"
    },
    "status": {
      "enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]
    },
    "recorded_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "current_entries_only",
        "publication_requires_explicit_approval",
        "media_binaries_committed",
        "unknown_paths_fail_closed"
      ],
      "properties": {
        "current_entries_only": {
          "type": "boolean"
        },
        "publication_requires_explicit_approval": {
          "type": "boolean"
        },
        "media_binaries_committed": {
          "type": "boolean"
        },
        "unknown_paths_fail_closed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "pattern": "^(manifests|workflows|config)/[^\\s]+$"
    },
    "entry": {
      "type": "object",
      "required": [
        "authority_id",
        "authority_type",
        "project_id",
        "path",
        "authority_state",
        "current",
        "execution_scope",
        "publication_authorized",
        "source_of_truth_for"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "authority_type": {
          "enum": [
            "asset",
            "character_status",
            "beatmap",
            "shot_manifest",
            "production_state",
            "review_master",
            "master_status",
            "release_readiness",
            "workflow",
            "provider_catalog",
            "library_routing"
          ]
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "path": {
          "$ref": "#/$defs/repository_path"
        },
        "authority_state": {
          "enum": [
            "ACTIVE",
            "FINAL",
            "LOCKED",
            "REVIEW",
            "BLOCKED",
            "APPROVED_LOCKED",
            "RELEASED"
          ]
        },
        "current": {
          "type": "boolean"
        },
        "execution_scope": {
          "enum": [
            "READ_ONLY",
            "PRODUCTION_ALLOWED_WITH_LOCK",
            "BLOCKED"
          ]
        },
        "publication_authorized": {
          "type": "boolean"
        },
        "source_of_truth_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "validation_kind": {
          "type": ["string", "null"],
          "enum": [
            "asset",
            "character_status",
            "beatmap",
            "shot_manifest",
            "production_state",
            "release_readiness",
            "alignment",
            "benchmark_suite",
            "provider_catalog",
            "library_routing",
            null
          ]
        },
        "predecessors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository_path"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
