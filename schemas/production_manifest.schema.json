{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxie's Wonder World Production Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "production_id",
    "title",
    "state",
    "audio",
    "beatmap",
    "timeline",
    "qc",
    "registry"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "production_id": {
      "type": "string",
      "pattern": "^VWW-[A-Z0-9][A-Z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "CONDITIONAL",
        "APPROVED",
        "APPROVED_LOCKED",
        "BLOCKED",
        "ARCHIVED"
      ]
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "status", "known_defects"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1},
        "known_defects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "beatmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "authoritative_sources"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "authoritative_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "fps",
        "shot_count",
        "unique_keyframes",
        "hold_or_continue_shots"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "fps": {"type": "integer", "minimum": 1},
        "shot_count": {"type": "integer", "minimum": 0},
        "unique_keyframes": {"type": "integer", "minimum": 0},
        "hold_or_continue_shots": {"type": "integer", "minimum": 0}
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_lock", "blocking_rules"],
      "properties": {
        "character_lock": {"type": "string", "minLength": 1},
        "blocking_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1}
      }
    }
  }
}
