{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxie Authority Content Lock",
  "type": "object",
  "required": [
    "lock_version",
    "lock_id",
    "record_type",
    "index_id",
    "index_path",
    "index_sha256",
    "algorithm",
    "entry_count",
    "entries"
  ],
  "properties": {
    "lock_version": {
      "type": "string",
      "minLength": 1
    },
    "lock_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "record_type": {
      "const": "authority_lock"
    },
    "index_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "index_path": {
      "const": "manifests/control/authority-index-v01.yaml"
    },
    "index_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "algorithm": {
      "const": "sha256"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["authority_id", "path", "sha256"],
        "properties": {
          "authority_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(manifests|workflows|config)/[^\\s]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
