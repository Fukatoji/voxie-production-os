{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxie Provider Catalog",
  "type": "object",
  "required": ["catalog_version", "status", "providers"],
  "properties": {
    "catalog_version": {"type": "string"},
    "status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["display_name", "transports", "connection_state", "capabilities"],
        "properties": {
          "display_name": {"type": "string", "minLength": 1},
          "transports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["connector", "cloud_browser", "api", "desktop"]}
          },
          "connection_state": {"enum": ["RUNTIME_CHECK_REQUIRED", "AVAILABLE", "UNAVAILABLE"]},
          "capabilities": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["risk_class", "chargeable", "execution_status", "approval_gates"],
              "properties": {
                "risk_class": {"enum": ["read_only", "creates_asset", "publishing", "canon_mutation", "destructive"]},
                "chargeable": {"type": "boolean"},
                "execution_status": {"enum": ["AVAILABLE", "RUNTIME_CHECK_REQUIRED", "WATCH"]},
                "approval_gates": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"enum": ["CREATE_MEDIA", "CREDIT_SPEND", "ASSET_UPLOAD", "PUBLISH_CONTENT", "CANON_LOCK", "DESTRUCTIVE_ACTION"]}
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
