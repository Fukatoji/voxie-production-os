  "lyrics": [
    {"line_id":"L01","text":"Oh, what could be inside this big wonder box? Let's listen carefully and follow the clues.","vocal_start_s":4.64,"vocal_end_s":10.48,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
    {"line_id":"L02","text":"What's the surprise? Listen and see.","vocal_start_s":15.215,"vocal_end_s":17.775,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
    {"line_id":"L03","text":"One little clue for you and me. Clap and tap and count to three. Wonder is waiting. What could it be?","vocal_start_s":20.015,"vocal_end_s":27.07,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
    {"line_id":"L04","text":"Here is clue number one.","vocal_start_s":28.75,"vocal_end_s":30.67,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
    {"line_id":"L05","text":"Clap. Clap. One, two. Now you try.","vocal_start_s":31.07,"vocal_end_s":35.15,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
    {"line_id":"L06","text":"Great job.","vocal_start_s":36.27,"vocal_end_s":37.39,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
    {"line_id":"L07","text":"What's the surprise? Listen and see.","vocal_start_s":48.195,"vocal_end_s":50.355003,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
    {"line_id":"L08","text":"One little clue for you and me. Clap and tap, then count to three. Wonder is waiting. What could it be?","vocal_start_s":52.97,"vocal_end_s":59.690002,"confidence":0.99,"beat_index":null,"bar_index":null,"manual_review":false},
